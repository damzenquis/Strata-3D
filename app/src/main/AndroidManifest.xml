<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:glEsVersion="0x00030000"
        android:required="true" />

    <!-- Guided capture. The camera is optional: the viewer works without it. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <!-- On-device reconstruction: a foreground service that keeps the CPU awake while it builds a model. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROCESSING" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- The capture's short "hold steady" buzz (a normal permission: granted at install, no prompt). -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.Strata">

        <!-- Guided capture: its own activity so the camera loads only when it opens. Portrait only. -->
        <activity
            android:name=".capture.ui.CaptureActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density"
            android:theme="@style/Theme.Strata" />

        <!-- configChanges: avoid tearing down the GL context (and re-uploading the model) on rotation. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- "Open with" for files that carry an STL MIME type. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="model/stl" />
                <data android:mimeType="model/x.stl-binary" />
                <data android:mimeType="model/x.stl-ascii" />
                <data android:mimeType="model/obj" />
                <data android:mimeType="model/wavefront-obj" />
                <data android:mimeType="model/ply" />
                <data android:mimeType="model/3mf" />
                <data android:mimeType="model/gltf+json" />
                <data android:mimeType="model/gltf-binary" />
                <data android:mimeType="application/sla" />
                <data android:mimeType="application/vnd.ms-pki.stl" />
                <data android:mimeType="application/x-navistyle" />
            </intent-filter>

            <!-- Many file managers report STL as a generic binary; the parser validates the content. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>

            <!-- Match by extension for file managers that pass file paths without a MIME type. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="file" />
                <data android:scheme="content" />
                <data android:host="*" />
                <data android:mimeType="*/*" />
                <data android:pathPattern=".*\\.stl" />
                <data android:pathPattern=".*\\.STL" />
                <data android:pathPattern=".*\\..*\\.stl" />
                <data android:pathPattern=".*\\..*\\.STL" />
                <data android:pathPattern=".*\\.obj" />
                <data android:pathPattern=".*\\.OBJ" />
                <data android:pathPattern=".*\\..*\\.obj" />
                <data android:pathPattern=".*\\..*\\.OBJ" />
                <data android:pathPattern=".*\\.ply" />
                <data android:pathPattern=".*\\.PLY" />
                <data android:pathPattern=".*\\..*\\.ply" />
                <data android:pathPattern=".*\\..*\\.PLY" />
                <data android:pathPattern=".*\\.3mf" />
                <data android:pathPattern=".*\\.3MF" />
                <data android:pathPattern=".*\\..*\\.3mf" />
                <data android:pathPattern=".*\\..*\\.3MF" />
                <data android:pathPattern=".*\\.gltf" />
                <data android:pathPattern=".*\\.GLTF" />
                <data android:pathPattern=".*\\..*\\.gltf" />
                <data android:pathPattern=".*\\..*\\.GLTF" />
                <data android:pathPattern=".*\\.glb" />
                <data android:pathPattern=".*\\.GLB" />
                <data android:pathPattern=".*\\..*\\.glb" />
                <data android:pathPattern=".*\\..*\\.GLB" />
            </intent-filter>

            <!-- Share sheet. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="model/stl" />
                <data android:mimeType="model/x.stl-binary" />
                <data android:mimeType="model/x.stl-ascii" />
                <data android:mimeType="model/obj" />
                <data android:mimeType="model/wavefront-obj" />
                <data android:mimeType="model/ply" />
                <data android:mimeType="model/3mf" />
                <data android:mimeType="model/gltf+json" />
                <data android:mimeType="model/gltf-binary" />
                <data android:mimeType="application/sla" />
                <data android:mimeType="application/vnd.ms-pki.stl" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>

            <!-- Share sheet with several files (a model plus the files it references). -->
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="model/stl" />
                <data android:mimeType="model/x.stl-binary" />
                <data android:mimeType="model/x.stl-ascii" />
                <data android:mimeType="model/obj" />
                <data android:mimeType="model/wavefront-obj" />
                <data android:mimeType="model/ply" />
                <data android:mimeType="model/3mf" />
                <data android:mimeType="model/gltf+json" />
                <data android:mimeType="model/gltf-binary" />
                <data android:mimeType="application/sla" />
                <data android:mimeType="application/vnd.ms-pki.stl" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
        </activity>

        <!-- Shares exported snapshots with other apps through temporary content-URI read grants. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/snapshot_paths" />
        </provider>
        <!-- Reconstruction runs in its own process, so a tool running out of memory never takes the app down. -->
        <service
            android:name=".capture.recon.ReconService"
            android:exported="false"
            android:foregroundServiceType="dataSync|mediaProcessing"
            android:process=":recon" />
    </application>

</manifest>
